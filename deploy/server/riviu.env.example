# Copy to /etc/riviu/riviu.env (chmod 600). No secrets go in this file:
# the password hash and the cookie-store key are separate files mounted by compose.yaml
# (/etc/riviu/password.hash and /etc/riviu/secret.key).

# Public address exactly as users type it (scheme + host, no path). Host/Origin must match.
RIVIU_PUBLIC_ORIGIN=https://113-161-254-76.sslip.io

# How long a login lasts, in days.
RIVIU_SESSION_DAYS=7

# Optional: time zone for timestamps in sheet names and reports.
TZ=Asia/Ho_Chi_Minh
