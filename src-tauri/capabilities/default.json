{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window capabilities for Riviu Reports.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-check-for-update",
    "allow-install-update",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/riviu-server",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}
