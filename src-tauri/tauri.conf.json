{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Riviu Reports",
  "version": "0.1.0",
  "identifier": "com.riviu.reports",
  "build": {
    "frontendDist": "../desktop-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Riviu Reports",
        "url": "loading.html",
        "width": 1400,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "externalBin": [
      "binaries/riviu-server"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc0ODk1Q0E2RDA2RjM3ODMKUldTRE4yL1FwbHlKZE4wdWN2UWFqc283WlUya3ZRcm1DRXQ0dmg4SUZqc0J6THdvRlRyZXpPdjgK",
      "endpoints": [
        "https://github.com/Riviudalat/Riviu_reports/releases/latest/download/latest.json"
      ]
    }
  }
}
